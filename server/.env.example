# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vortex
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be >= 32 characters in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS / frontend ───────────────────────────────────────────────────
# One origin, or several separated by commas (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ── Cookies ───────────────────────────────────────────────────────────
# lax    -> frontend and API share a site (same domain, or nginx/Vite proxy)  [default]
# none   -> frontend and API live on DIFFERENT sites (e.g. Vercel + Render). Forces Secure cookies (HTTPS).
COOKIE_SAMESITE=lax
# Secure flag defaults to true in production. Set false ONLY for plain-http local demos.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# ── Reverse proxy / rate limits ───────────────────────────────────────
# Number of proxies in front of the app (Render/Railway/nginx = 1). Defaults to 1 in production.
# TRUST_PROXY=1
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# ── Email (OTP codes + invitations) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="Vortex <noreply@example.com>"
