# Base URL of the API.
#  - Leave EMPTY / unset when the API is served from the same origin (nginx, Docker Compose, Vite dev proxy).
#  - Set to the full URL when the API lives on another domain, e.g. https://vortex-api.onrender.com/api/v1
#    (then the server needs COOKIE_SAMESITE=none and FRONTEND_URL=<this site>)
VITE_API_URL=

# Socket.io origin. Defaults to the API origin / current origin.
VITE_SOCKET_URL=

# Used only by `npm run dev` — where the Vite proxy forwards /api and /socket.io
DEV_API_TARGET=http://localhost:5000
